# Security headers for every page. Scripts only from this site (no inline scripts: page code lives in
# /assets/js/ and next to the invite pages). Styles allow inline because the pages set --accent per app
# and the hand-written privacy pages carry their own <style>. The contact form posts to formsubmit.co.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; upgrade-insecure-requests

# Netlify: let browsers keep images and the logo for a week (names stay the same when they change, so not immutable).
/assets/apps/*
  Cache-Control: public, max-age=604800
/assets/badges/*
  Cache-Control: public, max-age=604800
/assets/logo.svg
  Cache-Control: public, max-age=604800
# Universal links: iOS fetches this without a file extension and wants JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
